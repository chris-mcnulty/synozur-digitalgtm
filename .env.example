# Synozur Digital GTM Harness — environment configuration
# Copy to .env and fill in. .env is gitignored.

# Where the per-prospect markdown files live. A synced OneDrive folder so
# all agents on this machine see the same state. Example:
PROSPECT_DIR=~/OneDrive - Synozur/sales-harness/prospects

# Outlook account used to save drafts via Microsoft Graph. The agents use
# OAuth via the user's signed-in M365 identity; this is the address that
# owns the Drafts folder.
OUTLOOK_FROM=chris.mcnulty@synozur.com

# Global kill switch. Set to true to stop all agents at next loop tick.
AGENTS_PAUSED=false

# Per-rep, per-channel daily send cap. Cadence auto-pauses when hit.
DAILY_SEND_CAP_EMAIL=40

# Per-domain weekly send cap.
WEEKLY_SEND_CAP_PER_DOMAIN=5

# Campaign minimum reply rate. Auto-pause if below.
MIN_REPLY_RATE_PCT=5

# Suppression list path (relative to repo root or absolute).
SUPPRESSION_LIST=skills/compliance/suppression-list.md
